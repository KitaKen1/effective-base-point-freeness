/-- Killing an actual coordinate prefix constructs BOTH the exact kernel
map and the actual quotient basis from the untouched coordinate suffix. -/
theorem finite_coordinate_quotient_basis_exact
    {R M P : Type*} [CommRing R] [AddCommGroup M] [Module R M]
    [AddCommGroup P] [Module R P] {m r : ℕ}
    (b : Module.Basis (Fin (m + r)) R M) (q : M →ₗ[R] P)
    (hq : Function.Surjective q)
    (hker : LinearMap.ker q = Submodule.span R (Set.range fun i : Fin m => b (Fin.castAdd r i))) :
    ∃ (j : (Fin m → R) →ₗ[R] M) (c : Module.Basis (Fin r) R P),
      (∀ i, j (Pi.basisFun R (Fin m) i) = b (Fin.castAdd r i)) ∧
      Function.Injective j ∧ Function.Exact j q ∧
      ∀ i, c i = q (b (Fin.natAdd m i)) := by
  classical
  let j := (Pi.basisFun R (Fin m)).constr R (fun i => b (Fin.castAdd r i))
  let s : M →ₗ[R] (Fin m → R) := LinearMap.pi (fun i => b.coord (Fin.castAdd r i))
  have hj (i : Fin m) : j (Pi.basisFun R (Fin m) i) = b (Fin.castAdd r i) := by
    simp only [j, Module.Basis.constr_basis]
  have hsnorm (i : Fin m) : s (b (Fin.castAdd r i)) = Pi.basisFun R (Fin m) i := by
    ext k
    simp [s, Module.Basis.coord_apply, Finsupp.single_apply, Pi.single_apply, Fin.castAdd_inj, Pi.basisFun_apply, eq_comm]
  have hs : s.comp j = LinearMap.id := by
    apply (Pi.basisFun R (Fin m)).ext
    intro i
    rw [LinearMap.comp_apply, hj, hsnorm]
    rfl
  have hinj : Function.Injective j :=
    (show Function.LeftInverse s j from fun v => LinearMap.congr_fun hs v).injective
  have hex : Function.Exact j q := by
    intro w
    change w ∈ LinearMap.ker q ↔ w ∈ LinearMap.range j
    rw [hker]
    change w ∈ Submodule.span R (Set.range fun i => b (Fin.castAdd r i)) ↔
      w ∈ LinearMap.range ((Pi.basisFun R (Fin m)).constr R (fun i => b (Fin.castAdd r i)))
    rw [Module.Basis.constr_range]
  have hstail (i : Fin r) : s (b (Fin.natAdd m i)) = 0 := by
    ext k
    have hne : Fin.natAdd m i ≠ Fin.castAdd r k := by
      intro h
      have hv := congrArg Fin.val h
      change m + i.val = k.val at hv
      omega
    simp [s, Module.Basis.coord_apply, hne.symm]
  have hlib : LinearIndependent R (s ∘ b ∘ Fin.castAdd r) := by
    have hv : s ∘ b ∘ Fin.castAdd r = Pi.basisFun R (Fin m) := funext hsnorm
    rw [hv]
    exact (Pi.basisFun R (Fin m)).linearIndependent
  have hab : Codisjoint (Set.range (Fin.natAdd m : Fin r → Fin (m + r)))
      (Set.range (Fin.castAdd r : Fin m → Fin (m + r))) := by
    rw [codisjoint_iff]
    change Set.range (Fin.natAdd m : Fin r → Fin (m + r)) ∪
      Set.range (Fin.castAdd r : Fin m → Fin (m + r)) = Set.univ
    apply Set.eq_univ_of_forall
    intro i
    exact Fin.addCases (fun k => Or.inr ⟨k, rfl⟩) (fun k => Or.inl ⟨k, rfl⟩) i
  have htailinj : Function.Injective (Fin.natAdd m : Fin r → Fin (m + r)) := by
    intro i k h
    apply Fin.ext
    have hv := congrArg Fin.val h
    change m + i.val = m + k.val at hv
    omega
  let c : Module.Basis (Fin r) R P := Module.Basis.ofSplitExact
    (f := j) (g := q) (s := s) hs hex hq b
      (a := Fin.natAdd m) (b := Fin.castAdd r) htailinj hstail hlib hab
  exact ⟨j, c, hj, hinj, hex, fun i => Module.Basis.ofSplitExact_apply
    hs hex hq b htailinj hstail hlib hab i⟩


/-- For ANY finite actual quotient ideal, the actual pulled differential
kernel is generated by its actual equation differentials. No conormal
sequence or smoothness/regularity certificate is supplied. -/
theorem finite_quotient_differential_kernel_span
    {K A B ι : Type*} [CommRing K] [CommRing A] [CommRing B]
    [Algebra K A] [Algebra K B] [Algebra A B] [IsScalarTower K A B]
    (g : ι → A) (hsurj : Function.Surjective (algebraMap A B))
    (hker : RingHom.ker (algebraMap A B) = Ideal.span (Set.range g)) :
    LinearMap.ker (mapBaseChange K A B) =
      Submodule.span B (Set.range fun i => (1 : B) ⊗ₜ[A] D K A (g i)) := by
  classical
  let N := Submodule.span B (Set.range fun i => (1 : B) ⊗ₜ[A] D K A (g i))
  have hgen (x : A) (hx : x ∈ Ideal.span (Set.range g)) : (1 : B) ⊗ₜ[A] D K A x ∈ N := by
    induction hx using Submodule.span_induction with
    | mem x hx =>
      obtain ⟨i, rfl⟩ := hx
      exact Submodule.subset_span ⟨i, rfl⟩
    | zero => simp only [map_zero, TensorProduct.tmul_zero]; exact N.zero_mem
    | add x y _ _ hx hy =>
      rw [map_add, TensorProduct.tmul_add]
      exact N.add_mem hx hy
    | smul a x hx hdx =>
      change (1 : B) ⊗ₜ[A] D K A (a * x) ∈ N
      have hx0 : algebraMap A B x = 0 := RingHom.mem_ker.mp (hker ▸ hx)
      rw [quotient_equation_differential_mul x a hx0]
      exact N.smul_mem _ hdx
  apply le_antisymm
  · intro w hw
    obtain ⟨y, rfl⟩ := (exact_kerCotangentToTensor_mapBaseChange K A B hsurj w).mp hw
    obtain ⟨⟨x, hx⟩, rfl⟩ := Ideal.toCotangent_surjective (RingHom.ker (algebraMap A B)) y
    rw [kerCotangentToTensor_toCotangent]
    exact hgen x (hker ▸ hx)
  · apply Submodule.span_le.mpr
    rintro _ ⟨i, rfl⟩
    have hg0 : algebraMap A B (g i) = 0 := RingHom.mem_ker.mp
      (hker ▸ Ideal.subset_span (Set.mem_range_self i))
    change mapBaseChange K A B ((1 : B) ⊗ₜ[A] D K A (g i)) = 0
    rw [mapBaseChange_tmul, map_D, hg0, map_zero, smul_zero]


/-- An ACTUAL etale coordinate quotient internally supplies its injective
conormal map, exactness and quotient differential basis. The quotient ring
may be nonintegral; no target coordinates, smoothness, basis or exactness is input. -/
theorem etale_coordinate_quotient_differential_basis
    {K A B : Type*} [Field K] [CommRing A] [CommRing B]
    [Algebra K A] [Algebra K B] [Algebra A B] [IsScalarTower K A B]
    {m r : ℕ} (x : MvPolynomial (Fin (m + r)) K →ₐ[K] A)
    (hx : x.toRingHom.FormallyEtale) (hsurj : Function.Surjective (algebraMap A B))
    (hker : RingHom.ker (algebraMap A B) =
      Ideal.span (Set.range fun i : Fin m => x (MvPolynomial.X (Fin.castAdd r i)))) :
    ∃ (j : (Fin m → B) →ₗ[B] B ⊗[A] Ω[A⁄K]) (c : Module.Basis (Fin r) B Ω[B⁄K]),
      (∀ i, j (Pi.basisFun B (Fin m) i) =
        (1 : B) ⊗ₜ[A] D K A (x (MvPolynomial.X (Fin.castAdd r i)))) ∧
      Function.Injective j ∧ Function.Exact j (mapBaseChange K A B) ∧
      ∀ i, c i = D K B (algebraMap A B (x (MvPolynomial.X (Fin.natAdd m i)))) := by
  let bA := etaleCoordinateBasis x hx
  let b := bA.baseChange B
  have hnormal (i : Fin m) : b (Fin.castAdd r i) =
      (1 : B) ⊗ₜ[A] D K A (x (MvPolynomial.X (Fin.castAdd r i))) := by
    rw [Module.Basis.baseChange_apply, etaleCoordinateBasis_apply]
  have hv : (fun i : Fin m => b (Fin.castAdd r i)) =
      (fun i : Fin m => (1 : B) ⊗ₜ[A] D K A (x (MvPolynomial.X (Fin.castAdd r i)))) := funext hnormal
  have hdiff : LinearMap.ker (mapBaseChange K A B) =
      Submodule.span B (Set.range fun i : Fin m => b (Fin.castAdd r i)) := by
    rw [hv]
    exact finite_quotient_differential_kernel_span _ hsurj hker
  obtain ⟨j, c, hj, hinj, hex, hc⟩ := finite_coordinate_quotient_basis_exact b
    (mapBaseChange K A B) (mapBaseChange_surjective K A B hsurj) hdiff
  refine ⟨j, c, fun i => (hj i).trans (hnormal i), hinj, hex, ?_⟩
  intro i
  rw [hc, Module.Basis.baseChange_apply, etaleCoordinateBasis_apply,
    mapBaseChange_tmul, map_D, one_smul]


/-- Arbitrary-codimension ACTUAL coordinate quotient data construct a pure
normalized residue on the pulled ambient canonical line. Its target basis is
internally the remaining coordinate differentials, and its frame coefficient
is EXACTLY ONE. Intermediate quotient integrality is never assumed. -/
theorem etale_coordinate_quotient_pulled_canonical_residue
    {K A B : Type*} [Field K] [CommRing A] [CommRing B]
    [Algebra K A] [Algebra K B] [Algebra A B] [IsScalarTower K A B]
    {m r : ℕ} (x : MvPolynomial (Fin (m + r)) K →ₐ[K] A)
    (hx : x.toRingHom.FormallyEtale) (hsurj : Function.Surjective (algebraMap A B))
    (hker : RingHom.ker (algebraMap A B) =
      Ideal.span (Set.range fun i : Fin m => x (MvPolynomial.X (Fin.castAdd r i)))) :
    ∃ (c : Module.Basis (Fin r) B Ω[B⁄K])
      (R : (B ⊗[A] (⋀[A]^(m + r) Ω[A⁄K])) ≃ₗ[B] ⋀[B]^r Ω[B⁄K]),
      (∀ i, c i = D K B (algebraMap A B (x (MvPolynomial.X (Fin.natAdd m i))))) ∧
      (∀ z : Fin r → Ω[A⁄K],
        R ((1 : B) ⊗ₜ[A] exteriorPower.ιMulti A (m + r)
          (Fin.append (fun i : Fin m => D K A (x (MvPolynomial.X (Fin.castAdd r i)))) z)) =
            exteriorPower.ιMulti B r (KaehlerDifferential.map K K A B ∘ z)) ∧
      R ((1 : B) ⊗ₜ[A] exteriorPower.ιMulti A (m + r) (etaleCoordinateBasis x hx)) =
        exteriorPower.ιMulti B r c := by
  obtain ⟨j, c, hj, hinj, hex, hc⟩ := etale_coordinate_quotient_differential_basis x hx hsurj hker
  let : Module.Free B Ω[B⁄K] := Module.Free.of_basis c
  obtain ⟨e, he⟩ := OAI.ReverseLogKodaira.CanonicalAdjunction.exact_canonical_adjunction
    j (mapBaseChange K A B) hinj hex (mapBaseChange_surjective K A B hsurj)
      (Pi.basisFun B (Fin m)) c
  let a := determinantCoordinate (Pi.basisFun B (Fin m))
  let t := (TensorProduct.congr a (LinearEquiv.refl B (⋀[B]^r Ω[B⁄K]))).trans
    (TensorProduct.lid B (⋀[B]^r Ω[B⁄K]))
  let e' := t.symm.trans e
  have ha : a (exteriorPower.ιMulti B m (Pi.basisFun B (Fin m))) = 1 := by
    rw [determinantCoordinate_wedge, Module.Basis.det_self]
  have he' (z : Fin r → B ⊗[A] Ω[A⁄K]) :
      e' (exteriorPower.ιMulti B r (mapBaseChange K A B ∘ z)) =
        exteriorPower.ιMulti B (m + r)
          (Fin.append (fun i : Fin m => (1 : B) ⊗ₜ[A] D K A (x (MvPolynomial.X (Fin.castAdd r i)))) z) := by
    have ht : t (exteriorPower.ιMulti B m (Pi.basisFun B (Fin m)) ⊗ₜ[B]
        exteriorPower.ιMulti B r (mapBaseChange K A B ∘ z)) =
          exteriorPower.ιMulti B r (mapBaseChange K A B ∘ z) := by
      simp only [t, LinearEquiv.trans_apply, TensorProduct.congr_tmul,
        LinearEquiv.refl_apply, TensorProduct.lid_tmul, ha, one_smul]
    change e (t.symm _) = _
    rw [← ht, t.symm_apply_apply]
    simpa only [Function.comp_def, hj] using he (Pi.basisFun B (Fin m)) z
  let bA := etaleCoordinateBasis x hx
  let R := (finiteFreeExteriorBaseChangeEquiv (B := B) bA (m + r)).trans e'.symm
  have hR (z : Fin r → Ω[A⁄K]) :
      R ((1 : B) ⊗ₜ[A] exteriorPower.ιMulti A (m + r)
        (Fin.append (fun i : Fin m => D K A (x (MvPolynomial.X (Fin.castAdd r i)))) z)) =
          exteriorPower.ιMulti B r (KaehlerDifferential.map K K A B ∘ z) := by
    change e'.symm (finiteFreeExteriorBaseChangeEquiv (B := B) bA (m + r) _) = _
    rw [finiteFreeExteriorBaseChangeEquiv_tmul_wedge, one_smul]
    apply e'.injective
    rw [e'.apply_symm_apply]
    let w : Fin r → B ⊗[A] Ω[A⁄K] := fun i => (1 : B) ⊗ₜ[A] z i
    have hq : KaehlerDifferential.map K K A B ∘ z = mapBaseChange K A B ∘ w := by
      funext i
      simp only [Function.comp_apply, w, mapBaseChange_tmul, one_smul]
    rw [hq, he']
    congr 1
    funext i
    refine Fin.addCases (fun k => ?_) (fun k => ?_) i <;>
      simp only [Fin.append_left, Fin.append_right, w]
  refine ⟨c, R, hc, hR, ?_⟩
  have hb : Fin.append (fun i : Fin m => D K A (x (MvPolynomial.X (Fin.castAdd r i))))
      (fun i : Fin r => D K A (x (MvPolynomial.X (Fin.natAdd m i)))) = etaleCoordinateBasis x hx := by
    funext i
    refine Fin.addCases (fun k => ?_) (fun k => ?_) i <;>
      simp only [Fin.append_left, Fin.append_right, etaleCoordinateBasis_apply]
  have h := hR (fun i : Fin r => D K A (x (MvPolynomial.X (Fin.natAdd m i))))
  rw [hb] at h
  have hv : KaehlerDifferential.map K K A B ∘
      (fun i : Fin r => D K A (x (MvPolynomial.X (Fin.natAdd m i)))) = c := by
    funext i
    simp only [Function.comp_apply, map_D]
    exact (hc i).symm
  rw [hv] at h
  exact h

end MixedFujita
