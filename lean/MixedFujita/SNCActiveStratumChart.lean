module

public import MixedFujita.SNCTransverseGermChart
public import MixedFujita.SNCBasePrimeAppend
public import MixedFujita.SNCPointDivisorFamily

/-!
Identify the active closed SNC stratum with precisely the active coordinate
ideal of an actual etale chart. The previously proved base-uniformizer
transversality then constructs an adapted etale chart for the new cut,
including at nonclosed points over the base prime.
-/

@[expose] public section

open AlgebraicGeometry CategoryTheory TopologicalSpace IsLocalRing

namespace MixedFujita

set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
set_option backward.defeqAttrib.useBackward true

universe u

variable {K : Type u} [Field K] {n r : ℕ} {X : Scheme.{u}}
  [IsIntegral X] [IsLocallyNoetherian X] [X.Over (Spec (CommRingCat.of K))]
  [LocallyOfFiniteType (X ↘ Spec (CommRingCat.of K))]

/-- The actual active closed stratum equals the chart ideal generated by exactly the active coordinates. -/
theorem sncActiveStratumIdeal_stalk_eq_chart_span
    (c : EtaleChart K X n) (ξ : Fin r → X) (σ : Fin r → Option (Fin n))
    (hc : IsSNCChart c ξ σ) (x : X) (hx : x ∈ c.U) :
    (sncActiveStratumIdeal (sncDivisorFamilyOfPoints ξ) x).stalkIdeal x =
      Ideal.span (Set.range fun a : {a : Fin n // ∃ i, σ i = some a ∧ x ∈ closure ({ξ i} : Set X)} =>
        X.presheaf.germ c.U x hx (c.coords (MvPolynomial.X a.1))) := by
  classical
  have hsupport (i : Fin r) : x ∈ ((sncDivisorFamilyOfPoints ξ).component (ULift.up i)).support ↔
      x ∈ closure ({ξ i} : Set X) := by
    change x ∈ ((Scheme.IdealSheafData.vanishingIdeal
      (⟨closure ({ξ i} : Set X), isClosed_closure⟩ : Closeds X)).support : Set X) ↔ _
    rw [Scheme.IdealSheafData.coe_support_vanishingIdeal]
    rfl
  apply le_antisymm
  · rw [sncActiveStratumIdeal, sncStratumIdeal, Scheme.IdealSheafData.stalkIdeal_iSup']
    apply iSup_le
    intro i
    rw [Scheme.IdealSheafData.stalkIdeal_iSup']
    apply iSup_le
    intro hi
    have hxi := (hsupport i.down).mp (Finset.mem_filter.mp hi).2
    cases hσ : σ i.down with
    | none =>
      have hset := hc.2 i.down
      rw [hσ, Option.elim_none] at hset
      have hempty : x ∈ (∅ : Set X) := hset ▸ ⟨hxi, hx⟩
      exact hempty.elim
    | some a =>
      rw [show i = ULift.up i.down from rfl,
        sncDivisorFamilyOfPoints_stalk_on_chart c ξ σ hc x hx i.down, hσ, Option.elim_some]
      apply Ideal.span_le.mpr
      rintro b rfl
      exact Ideal.subset_span ⟨⟨a, i.down, hσ, hxi⟩, rfl⟩
  · apply Ideal.span_le.mpr
    rintro b ⟨a, rfl⟩
    obtain ⟨i, hi, hxi⟩ := a.2
    have hle : ((sncDivisorFamilyOfPoints ξ).component (ULift.up i)).stalkIdeal x ≤
        (sncActiveStratumIdeal (sncDivisorFamilyOfPoints ξ) x).stalkIdeal x := by
      rw [sncActiveStratumIdeal, sncStratumIdeal, Scheme.IdealSheafData.stalkIdeal_iSup']
      apply le_iSup_of_le (ULift.up i)
      rw [Scheme.IdealSheafData.stalkIdeal_iSup']
      exact le_iSup_of_le (Finset.mem_filter.mpr ⟨Finset.mem_univ _, (hsupport i).mpr hxi⟩) le_rfl
    apply hle
    rw [sncDivisorFamilyOfPoints_stalk_on_chart c ξ σ hc x hx i, hi, Option.elim_some]
    exact Ideal.mem_span_singleton_self _

/-- Transversality to the actual active stratum gives an actual joint etale SNC chart. -/
theorem exists_sncChartWith_of_active_stratum_transverse_germ [PerfectField K]
    (c : EtaleChart K X n) (ξ : Fin r → X) (σ : Fin r → Option (Fin n))
    (hc : IsSNCChart c ξ σ) (Z : Set X) (g : Γ(X, c.U)) (x : X) (hx : x ∈ c.U)
    (hg : X.presheaf.germ c.U x hx g ∈ maximalIdeal (X.presheaf.stalk x))
    (htrans : X.presheaf.germ c.U x hx g ∉ maximalIdeal (X.presheaf.stalk x) ^ 2 ⊔
      (sncActiveStratumIdeal (sncDivisorFamilyOfPoints ξ) x).stalkIdeal x)
    (hZg : ∀ z ∈ c.U, z ∈ Z ↔ z ∉ X.basicOpen g) :
    ∃ (c' : EtaleChart K X n) (σ' : Fin r → Option (Fin n)) (τ : Option (Fin n)),
      x ∈ c'.U ∧ IsSNCChartWith c' ξ σ' Z τ := by
  rw [sncActiveStratumIdeal_stalk_eq_chart_span c ξ σ hc x hx] at htrans
  exact exists_sncChartWith_of_transverse_germ c hc Z g hx hg htrans hZg

/-- The proved all-stratum base transversality gives adapted etale charts for the actual uniformizer cut. -/
theorem exists_sncChartWith_of_base_uniformizer_germ [PerfectField K]
    {Y : Scheme.{u}} (q : X ⟶ Y) (V : Y.Opens)
    (ξ : Fin r → X) (htrans : SNCStrataUniformizerTransverseOn q (sncDivisorFamilyOfPoints ξ) V)
    (c : EtaleChart K X n) (σ : Fin r → Option (Fin n)) (hc : IsSNCChart c ξ σ)
    (Z : Set X) (g : Γ(X, c.U)) (x : X) (hx : x ∈ c.U) (hxV : q x ∈ V)
    (hcoh : Order.coheight (q x) = 1) (a : Y.presheaf.stalk (q x)) (ha : Irreducible a)
    (hgerm : X.presheaf.germ c.U x hx g = (q.stalkMap x).hom a)
    (hZg : ∀ z ∈ c.U, z ∈ Z ↔ z ∉ X.basicOpen g) :
    ∃ (c' : EtaleChart K X n) (σ' : Fin r → Option (Fin n)) (τ : Option (Fin n)),
      x ∈ c'.U ∧ IsSNCChartWith c' ξ σ' Z τ := by
  classical
  have hat : (q.stalkMap x).hom a ∉ maximalIdeal (X.presheaf.stalk x) ^ 2 ⊔
      (sncActiveStratumIdeal (sncDivisorFamilyOfPoints ξ) x).stalkIdeal x := by
    apply sncStratum_uniformizer_transverse_at_mem_support q (sncDivisorFamilyOfPoints ξ) V htrans
      (Finset.univ.filter fun i => x ∈ ((sncDivisorFamilyOfPoints ξ).component i).support) x
      (sncActiveStratumIdeal_mem_support (sncDivisorFamilyOfPoints ξ) x) hxV hcoh a ha
  have ham : a ∈ maximalIdeal (Y.presheaf.stalk (q x)) := by
    simpa only [mem_maximalIdeal, mem_nonunits_iff] using ha.not_isUnit
  apply exists_sncChartWith_of_active_stratum_transverse_germ c ξ σ hc Z g x hx _ _ hZg
  · rw [hgerm]
    exact map_nonunit (q.stalkMap x).hom a ham
  · rwa [hgerm]

end MixedFujita
